/* Number of subarrays whose sum of number = K */
#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
	int n, k;
	cin >> n >> k;
	
	vector<int> arr(n);
	for(int i = 0; i < n; i++) cin >> arr[i];
	
	long long sum = 0, cnt = 0;
	for(int i = 0, j = 0; j < n; j++) {
		sum += arr[j];
		
		while(sum > k) {
			sum -= arr[i];
			i++;
		}
		
		if(sum == k) cnt++;
	}
	
	cout << cnt << "\n";
	
	return 0;
}
