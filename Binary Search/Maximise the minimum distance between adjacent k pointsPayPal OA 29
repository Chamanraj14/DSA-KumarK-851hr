// Understanding :-> We are given “N” points. We have to select k points ; and we have to discuss what is the minimum possible distance b/w any of the k points selected. 

// Analysis :-> If you select “k” points; the minimum distance of any of the k points will be nothing but the adjacent difference of the k points in sorted format 

// -> You check all the adjacent differences and the minimum of them is your minimum possible distance. 

// ->Actual Question :-> This minimum possible distance should be as big as possible. 

// You have to select such k points such that the minimum difference you get of those adjacent points is as big as possible.

#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
	int n, k;
	cin >> n >> k;
	
	if(k <= 1) cout << "0" << "\n";
	
	vector<int> arr(n);
	for(int i = 0; i < n; i++) cin >> arr[i];
	sort(arr.begin(), arr.end());
	int low = 0, high = arr[n-1]-arr[0];
	int ans = 0;
	
	while(low <= high) {
		int mid = low + (high-low)/2;
		
		int cnt = 1, prev = arr[0];
		for(int i = 1; i < n; i++) {
			if(arr[i]-prev >= mid) {
				cnt++;
				prev = arr[i];
			}
		}
		
		if(cnt >= k) {
			ans = mid;
			low = mid+1;
		}
		else high = mid-1;
	}
	
	cout << ans << "\n";
	
	return 0;
}
