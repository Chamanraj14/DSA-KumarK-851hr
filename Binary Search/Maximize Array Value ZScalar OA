// 31. Maximize Array Value

// Given an array arr of n positive integers, the following operation can be performed any number of times. Use a 1-based index for the array.

// * Choose any i such that 2 <= i <= n.
// * Choose any x such that 1 <= x <= arr[i].
// * Set arr[i-1] to arr[i-1] + x.
// * Set arr[i] to arr[i] - x.

// Minimize the maximum value of arr using the operation and return its value.

#include <bits/stdc++.h>
using namespace std;

bool check(vector<long long> arr, long long mid) {
	int n = arr.size() - 1;

	for(int i = n; i >= 2; i--) {
		if(arr[i] > mid) {
			long long extra = arr[i] - mid;
			arr[i] = mid;
			arr[i-1] += extra;
		}
	}

	return arr[1] <= mid;
}

int main() {
	// your code goes here
	int n;
	cin >> n;

	vector<long long> arr(n+1);
	long long low = 0, high = 0;

	for(int i = 1; i <= n; i++) {
		cin >> arr[i];
		high = max(high, arr[i]);
	}

	long long ans = high;

	while(low <= high) {
		long long mid = low + (high-low)/2;

		if(check(arr, mid)) {
			ans = mid;
			high = mid-1;
		}
		else {
			low = mid+1;
		}
	}

	cout << ans;

	return 0;
}
