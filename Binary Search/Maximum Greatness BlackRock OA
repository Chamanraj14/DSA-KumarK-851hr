/*
1. Maximum Greatness

Given an array arr, we can rearrange it to form another array, let's call it
rearranged_arr. The greatness of the array is defined as the number of indices i, 0 <= 
i < n, where rearranged_arr[i] > arr[i]. That is, the element placed after
rearrangement is greater than the initial value present at that index.

Given the initial array arr, find the maximum possible greatness which can be
achieved by some rearrangement of the array.

Example
arr = [1, 3, 5, 2, 1, 3, 1]

[1, 3, 5, 2, 1, 3, 1] -> original arr
[2, 5, 1, 3, 3, 1, 1] -> optimal rearranged_arr

Here, at indices 0, 1, 3, and 4 in bold, rearranged_arr[i] > arr[i]. It can be shown that
this is the maximum possible greatness. Thus, the answer is 4.
*/
#include <bits/stdc++.h>
using namespace std;

bool check(int mid, vector<int>& arr) {
	int n = arr.size(), v = n - 1, i = mid - 1 ; 
 
    while(i>=0){
        if(arr[v] <= arr[i]){
            return false;
        }
        i--;
        v--;
    }
 
    return true; 
}
int main() {
	// your code goes here
	int n;
	cin >> n;
	
	vector<int> arr(n);
	for(int i = 0; i < n; i++) cin >> arr[i];
	sort(arr.begin(), arr.end());
	
	int low = 0, high = n-1;
	int ans = 0;
	
	while(low <= high) {
		int mid = low + (high-low)/2;
		
		if(check(mid, arr)) {
			ans = mid;
			low = mid+1;
		}
		else high = mid-1;
	}
	
	cout << ans << "\n";
	
	return 0;
}
